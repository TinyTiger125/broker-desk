# Customer-facing access: enable Clerk explicitly or provide both Clerk keys.
BROKER_DESK_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: Clerk JWT public key for networkless session verification.
# Copy the PEM value from Clerk Dashboard -> API Keys -> JWT Public Key.
CLERK_JWT_KEY=

# Shared PostgreSQL beta database. `DATABASE_URL` is the restricted runtime
# role: it must not own tables or have BYPASSRLS. Apply migrations before
# starting the app; runtime code never creates or changes its schema.
# DATA_DRIVER=postgres
# DATABASE_URL=postgresql://brokerdesk_runtime:...@HOST:5432/broker_desk?sslmode=verify-full
# DATABASE_DEVELOPMENT_URL=postgresql://migration_owner:...@HOST:5432/broker_desk?sslmode=verify-full
# DATABASE_MIGRATION_URL=postgresql://migration_owner:...@HOST:5432/broker_desk?sslmode=verify-full
#
# Webhook-only management connection. Required only for production Clerk user
# lifecycle sync; never expose it to the browser or normal request handlers.
# DATABASE_ADMIN_URL=postgresql://brokerdesk_admin:...@HOST:5432/broker_desk?sslmode=verify-full

# Low-volume public-beta attachment storage. The PostgreSQL adapter is private,
# tenant-scoped and hard-capped at 10 MB per attachment. Replace it with an
# audited private object-storage adapter before large-scale production use.
# ATTACHMENT_STORAGE_MODE=postgres_private

# The production document reader is an HTTPS-only service which receives
# private identity-document bytes from the import worker. List its exact host
# names here (comma-separated) before opening the production gate.
# DOCUMENT_READING_PROVIDER=remote
# DOCUMENT_READING_ENDPOINT=https://reader.example.com/v1/extract
# DOCUMENT_READING_API_TOKEN=replace-with-a-long-secret
# DOCUMENT_READING_ALLOWED_HOSTS=reader.example.com

# Production imports are queued, then claimed by a separate authenticated
# worker. Run `npm run worker:import` from a scheduler at the documented
# cadence. This is deliberately not enabled by a normal web request.
# BROKER_DESK_IMPORT_WORKER_ENABLED=true
# BROKER_DESK_IMPORT_WORKER_SCHEDULE="every 1 minute"
# BROKER_DESK_IMPORT_WORKER_TOKEN=replace-with-32-or-more-random-characters
# BROKER_DESK_APP_URL=https://app.example.com

# Public HTTPS deployment gate. The application refuses to run in production
# until a shared edge policy has been deployed and its policy identifier is recorded.
# BROKER_DESK_EDGE_RATE_LIMIT_ENFORCED=true
# BROKER_DESK_EDGE_RATE_LIMIT_POLICY_ID=your-provider-policy-id

# Local-only QA escape hatch. Never use this for a shared or public test link.
# BROKER_DESK_AUTH_MODE=demo
