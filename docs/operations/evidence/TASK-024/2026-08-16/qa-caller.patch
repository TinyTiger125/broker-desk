+"use client";
+
+import type { ComponentProps } from "react";
+import { useRef } from "react";
+import { useFormStatus } from "react-dom";
+
+type PostalQaFormProps = {
+  action: ComponentProps<"form">["action"];
+  caseId: string;
+  initialValue: string;
+  label: string;
+  value: string;
+};
+
+function SubmitButton({ value }: { value: string }) {
+  const { pending } = useFormStatus();
+
+  return (
+    <button
+      type="submit"
+      disabled={pending}
+      className="rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white transition hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-60"
+    >
+      {pending ? "送信中…" : `送信: ${value}`}
+    </button>
+  );
+}
+
+export function PostalQaForm({ action, caseId, initialValue, label, value }: PostalQaFormProps) {
+  const scrollTopRef = useRef<HTMLInputElement>(null);
+
+  return (
+    <form
+      action={action}
+      onSubmit={() => {
+        if (scrollTopRef.current) {
+          scrollTopRef.current.value = String(Math.max(0, Math.round(document.scrollingElement?.scrollTop ?? window.scrollY)));
+        }
+      }}
+      className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
+    >
+      <input type="hidden" name="caseId" value={caseId} />
+      <input type="hidden" name="presentFieldKeysJson" value='["applicant.currentPostalCode"]' />
+      <input type="hidden" name="returnView" value="overview" />
+      <input type="hidden" name="returnAnchor" value="case-section-participants" />
+      <input type="hidden" name="returnField" value="applicant.currentPostalCode" />
+      <input type="hidden" name="returnScrollTop" ref={scrollTopRef} value="" readOnly />
+      <input type="hidden" name="saveMode" value="manual" />
+      <label className="block text-sm font-bold text-slate-900" htmlFor={`postal-qa-${value}`}>
+        {label}
+      </label>
+      <div className="mt-2 flex flex-wrap items-center gap-3">
+        <input
+          id={`postal-qa-${value}`}
+          name="field:applicant.currentPostalCode"
+          defaultValue={initialValue}
+          inputMode="numeric"
+          autoComplete="off"
+          className="min-w-0 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-950 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200"
+        />
+        <SubmitButton value={value} />
+      </div>
+    </form>
+  );
+}
